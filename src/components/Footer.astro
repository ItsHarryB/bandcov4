---
import Social from "./Social.jsx";
import "../styles/global.css";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <link rel="sitemap" href="/sitemap-index.xml" />

  <div class="footer-container">
    <div class="footer-section footer-left">    
      <div class="other-websites" style="margin-bottom: 1.5rem;">
        <h4 id="other-sites-heading">My Other Websites:</h4>
        <ul aria-labelledby="other-sites-heading">
          <li>
            <a href="https://web.brightonandco.co.uk" target="_blank" rel="noopener noreferrer" class="footer-site-link">
                <img src="/webfavicon.png" alt="" class="footer-site-logo" width="28" height="28" loading="lazy" decoding="async" />
              Brighton and Co
            </a>
          </li>
          <li>
            <a href="https://old.brightonandco.co.uk" target="_blank" rel="noopener noreferrer" class="footer-site-link">
                <img src="/oldfavicon.png" alt="" class="footer-site-logo" width="28" height="28" loading="lazy" decoding="async" />
              OLD: Brighton and Co
            </a>
          </li>
        </ul>
      </div>
      <p>
        &copy; {currentYear} Brighton and Co. <br />
        All rights reserved.
      </p>
    </div>

    <div class="footer-section footer-middle">
      <h4 id="social-heading">Follow Me:</h4>
      <div class="social-links" role="list" aria-labelledby="social-heading">
        <Social platform="Twitter" username="ItsHarryB_" url="" iconOnly client:visible />
        
        <Social platform="GitHub" username="ItsHarryB" url="" iconOnly client:visible />
        
        <Social
          platform="LinkedIn"
          username=""
          url="https://www.linkedin.com/in/harry-brighton-8a2b971a4/"
          iconOnly
          client:visible
        />
      </div>
    </div>

    <div class="footer-section footer-right">
      <h4 id="quick-links-heading">Quick Links:</h4>
      <ul aria-labelledby="quick-links-heading">
        <li><a href="/">Home</a></li>
        <li><a href="/enquiries/">Enquiries</a></li>
        <li><a href="/about-me/">About Me</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/photography/">Photography</a></li>
        <li><a href="/links/">Links</a></li>
        <li><a href="/terms-and-conditions/">Terms and Conditions</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-toggle" style="margin-bottom: 0.5rem;">
    <h4 id="theme-toggle-heading">Toggle Theme:</h4>
    <div class="theme-toggle-switch" aria-labelledby="theme-toggle-heading">
      <button
        type="button"
        class="toggle-track"
        id="theme-toggle-btn"
        role="switch"
        aria-checked="false"
        aria-label="Toggle dark mode"
      >
        <span class="icons" aria-hidden="true">
          <span class="sun">☀︎</span>
          <span class="moon">☾</span>
        </span>
        <span class="toggle-thumb" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="footer-carbon-badge">
    <div id="wcb" class="carbonbadge"></div>
  </div>

  <div class="footer-meta" style="margin-top: 1.25rem;">
    <p>
      TEST: Brighton and Co Website – Made by Harry Brighton | Version 0.13.0 - 20/03/2026
    </p>
  </div>
</footer>

<script>
  // ==========================================
  // Theme Toggle Logic
  // ==========================================
  const setupThemeToggle = () => {
    const themeBtn = document.getElementById('theme-toggle-btn');
    const root = document.documentElement;
    const wcbBadge = document.getElementById('wcb');

    if (!themeBtn) return;

    // Read current state
    const isDark = root.classList.contains('dark') || localStorage.getItem('theme') === 'dark';
    
    // Set initial button state
    themeBtn.setAttribute('aria-checked', isDark.toString());
    if (isDark && wcbBadge) wcbBadge.classList.add('wcb-d');

    const applyTheme = (theme: 'dark' | 'light') => {
      if (theme === 'dark') {
        root.classList.add('dark');
        if (wcbBadge) wcbBadge.classList.add('wcb-d');
      } else {
        root.classList.remove('dark');
        if (wcbBadge) wcbBadge.classList.remove('wcb-d');
      }
      
      localStorage.setItem('theme', theme);
      themeBtn.setAttribute('aria-checked', (theme === 'dark').toString());
      document.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
    };

    themeBtn.addEventListener('click', () => {
      const isCurrentlyDark = root.classList.contains('dark');
      applyTheme(isCurrentlyDark ? 'light' : 'dark');
    });
  };

  // ==========================================
  // Carbon Badge Injection Logic
  // ==========================================
  const setupCarbonBadge = () => {
    let scriptInjected = false;

    const inject = () => {
      if (document.querySelector('script[data-carbon-badge]')) return;

      const s = document.createElement("script");
      s.src = "https://unpkg.com/website-carbon-badges@1.1.3/b.min.js";
      s.defer = true;
      s.setAttribute("data-carbon-badge", "true");
      s.onerror = () => console.warn("Website Carbon Badge script failed to load");
      
      document.body.appendChild(s);
      scriptInjected = true;
    };

    inject();

    let attempts = 0;
    const maxAttempts = 2;
    const timers: number[] = [];
    let badgeLoaded = false;

    const isLoaded = () => {
      const el = document.getElementById("wcb");
      return !!el?.querySelector("a[href*='websitecarbon.com'], svg") &&
             !/no result/i.test(el.textContent || "");
    };

    const retry = () => {
      if (badgeLoaded) return;
      const el = document.getElementById("wcb");
      if (!el) return;

      if (isLoaded()) {
        badgeLoaded = true;
        return;
      }

      if (attempts < maxAttempts) {
        attempts++;
        document.querySelectorAll('script[src*="website-carbon-badges"]').forEach((n) => n.remove());
        el.innerHTML = "";
        scriptInjected = false;
        
        timers.push(
          window.setTimeout(() => {
            inject();
            timers.push(window.setTimeout(retry, 6000));
          }, 4000 * attempts)
        );
      } else {
        el.style.display = "none";
        el.closest('.footer-carbon-badge')?.setAttribute('style', 'display: none;');
      }
    };

    timers.push(window.setTimeout(retry, 8000));
  };

  // Run scripts on load (and handle Astro View Transitions)
  document.addEventListener('astro:page-load', () => {
    setupThemeToggle();
    setupCarbonBadge();
  });
  
  // Fallback for initial load if View Transitions aren't used
  if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
    setupThemeToggle();
    setupCarbonBadge();
  }
</script>
<style>
  /* The layout for the logo and text */
  .footer-site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    /* We removed text-decoration: none here so it arbs the global underline! */
  }

  .footer-site-logo {
    width: 28px; /* Matches the new HTML width */
    height: 28px; /* Matches the new HTML height */
    object-fit: contain; /* Changed from 'cover' so it doesn't crop */
    
    /* REMOVED border-radius and box-shadow so there is no background box */
    
    /* We use filter: drop-shadow instead! This makes the shadow hug the exact shape of your transparent logo, rather than casting a square shadow */
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15));
    
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.3s ease;
  }

  /* The pronounced hover effect */
  .footer-site-link:hover .footer-site-logo {
    transform: scale(1.2);
    /* The drop shadow deepens to make the actual logo look like it's lifting off the page */
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.25));
  }
</style>