---
import Social from "./Social.astro";
import ThemeToggle from "./ThemeToggle.astro"; // <-- Imported here!
import "../styles/global.css";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <link rel="sitemap" href="/sitemap-index.xml" />

  <div class="footer-container">
    
    <div class="footer-section">
      <h4 id="other-sites-heading">My Other Websites:</h4>
      <ul aria-labelledby="other-sites-heading">
        <li>
          <a href="https://test.brightonandco.co.uk" target="_blank" rel="noopener noreferrer" class="footer-site-link">
            <img src="/testfavicon.png" alt="" class="footer-site-logo" width="28" height="28" loading="lazy" decoding="async" />
            TEST: Brighton and Co
          </a>
        </li>
        <li>
          <a href="https://old.brightonandco.co.uk" target="_blank" rel="noopener noreferrer" class="footer-site-link">
            <img src="/oldfavicon.png" alt="" class="footer-site-logo" width="28" height="28" loading="lazy" decoding="async" />
            OLD: Brighton and Co
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-section">
      <h4 id="quick-links-heading">Quick Links:</h4>
      <ul aria-labelledby="quick-links-heading">
        <li><a href="/">Home</a></li>
        <li><a href="/enquiries/">Enquiries</a></li>
        <li><a href="/about-me/">About Me</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/photography/">Photography</a></li>
        <li><a href="/links/">Links</a></li>
        <li><a href="/terms-and-conditions/">Terms and Conditions</a></li>
      </ul>
    </div>

    <div class="footer-section">
      <h4 id="social-heading">Follow Me:</h4>
      <div class="social-links" role="list" aria-labelledby="social-heading">
        <Social platform="Twitter" username="ItsHarryB_" url="" iconOnly />
        <Social platform="GitHub" username="ItsHarryB" url="" iconOnly />
        <Social platform="LinkedIn" username="" url="https://www.linkedin.com/in/harry-brighton-8a2b971a4/" iconOnly />
      </div>
    </div>

    <div class="footer-section">
      <h4 id="theme-toggle-heading">Toggle Theme:</h4>
      <div class="theme-toggle-switch" aria-labelledby="theme-toggle-heading">
        <ThemeToggle /> </div>
    </div>

  </div> 
  
  <div class="footer-bottom">
    <div class="footer-copyright">
      &copy; {currentYear} Brighton and Co. All rights reserved.
    </div>

    <div class="footer-carbon-badge">
      <div id="wcb" class="carbonbadge"></div>
    </div>

    <div class="footer-meta">
      Brighton and Co Website – Made by Harry Brighton <br />
      Version 4.2.6a - 29/03/2026
    </div>
  </div>
</footer>

<script>
  // ==========================================
  // Carbon Badge Injection Logic ONLY
  // ==========================================
  const setupCarbonBadge = () => {
    let scriptInjected = false;

    const inject = () => {
      if (document.querySelector('script[data-carbon-badge]')) return;

      const s = document.createElement("script");
      s.src = "https://unpkg.com/website-carbon-badges@1.1.3/b.min.js";
      s.defer = true;
      s.setAttribute("data-carbon-badge", "true");
      s.onerror = () => console.warn("Website Carbon Badge script failed to load");
      
      document.body.appendChild(s);
      scriptInjected = true;
    };

    inject();

    let attempts = 0;
    const maxAttempts = 2;
    const timers: number[] = [];
    let badgeLoaded = false;

    const isLoaded = () => {
      const el = document.getElementById("wcb");
      return !!el?.querySelector("a[href*='websitecarbon.com'], svg") &&
             !/no result/i.test(el.textContent || "");
    };

    const retry = () => {
      if (badgeLoaded) return;
      const el = document.getElementById("wcb");
      if (!el) return;

      if (isLoaded()) {
        badgeLoaded = true;
        
        // --- NEW ADDITION: KEEP BADGE SYNCED WITH THEME ---
        // Ensure the badge updates its colors based on the current theme state
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
            el.classList.add('wcb-d');
        } else {
            el.classList.remove('wcb-d');
        }
        return;
      }

      if (attempts < maxAttempts) {
        attempts++;
        document.querySelectorAll('script[src*="website-carbon-badges"]').forEach((n) => n.remove());
        el.innerHTML = "";
        scriptInjected = false;
        
        timers.push(
          window.setTimeout(() => {
            inject();
            timers.push(window.setTimeout(retry, 6000));
          }, 4000 * attempts)
        );
      } else {
        el.style.display = "none";
        el.closest('.footer-carbon-badge')?.setAttribute('style', 'display: none;');
      }
    };

    timers.push(window.setTimeout(retry, 8000));
    
    // Listen for the custom event fired by ThemeToggle.astro to update the badge color
    document.addEventListener('themechange', ((e: CustomEvent) => {
        const el = document.getElementById("wcb");
        if (el) {
            if (e.detail.theme === 'dark') {
                el.classList.add('wcb-d');
            } else {
                el.classList.remove('wcb-d');
            }
        }
    }) as EventListener);
  };

  // Run scripts on load (and handle Astro View Transitions)
  document.addEventListener('astro:page-load', () => {
    setupCarbonBadge();
  });
  
  // Fallback for initial load if View Transitions aren't used
  if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
    setupCarbonBadge();
  }
</script>

<style>
  /* The layout for the logo and text */
  .footer-site-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    /* We removed text-decoration: none here so it arbs the global underline! */
  }

  .footer-site-logo {
    width: 28px; /* Matches the new HTML width */
    height: 28px; /* Matches the new HTML height */
    object-fit: contain; /* Changed from 'cover' so it doesn't crop */
    
    /* REMOVED border-radius and box-shadow so there is no background box */
    
    /* We use filter: drop-shadow instead! This makes the shadow hug the exact shape of your transparent logo, rather than casting a square shadow */
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15));
    
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.3s ease;
  }

  /* The pronounced hover effect */
  .footer-site-link:hover .footer-site-logo {
    transform: scale(1.2);
    /* The drop shadow deepens to make the actual logo look like it's lifting off the page */
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.25));
  }
</style>