---
const currentPath = Astro.url.pathname; 
---

<header class="site-header" transition:persist="site-header">
  <button type="button" class="hamburger" id="hamburger" aria-expanded="false" aria-controls="nav" aria-label="Open navigation menu">
    <span class="line line1"></span>
    <span class="line line2"></span>
    <span class="line line3"></span>
  </button>

  <div class="site-title">
    <a href="/" class="site-logo-link">
      <img 
        src="/favicon.png" 
        alt="Site Logo" 
        width="40" 
         height="40" 
           loading="eager" 
            decoding="sync" 
      />
      <span class="site-title-text">TEST: Brighton and Co</span>
    </a>
  </div>

  <nav class="nav-links" id="nav" aria-label="Main navigation">
    <a href="/" class={currentPath === "/" ? "active" : ""} aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
    <a href="/enquiries/" class={currentPath.startsWith("/enquiries") ? "active" : ""} aria-current={currentPath.startsWith("/enquiries") ? "page" : undefined}>Enquiries</a>
    
    <div class="dropdown-group" id="about-dropdown">
      <div class="dropdown-primary">
        <button class="dropdown-toggle" aria-expanded="false" aria-label="Toggle About Me sub-menu">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chevron"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <a href="/about-me/" class={currentPath === "/about-me/" || currentPath === "/about-me" ? "active" : ""} aria-current={currentPath === "/about-me/" || currentPath === "/about-me" ? "page" : undefined}>About Me</a>
      </div>
      <div class="dropdown-menu">
        <a href="/about-me/" class={currentPath === "/about-me/" || currentPath === "/about-me" ? "active" : ""}>About Me</a>
        <a href="/about-me/cv/" class={currentPath.startsWith("/about-me/cv") ? "active" : ""}>My CV</a>
      </div>
    </div>

    <a href="/blog/" class={currentPath.startsWith("/blog") ? "active" : ""} aria-current={currentPath.startsWith("/blog") ? "page" : undefined}>Blog</a>
    <a href="/photography/" class={currentPath.startsWith("/photography") ? "active" : ""} aria-current={currentPath.startsWith("/photography") ? "page" : undefined}>Photography</a>
    <a href="/links/" class={currentPath.startsWith("/links") ? "active" : ""} aria-current={currentPath.startsWith("/links") ? "page" : undefined}>Links</a>
  </nav>

  <div class="nav-overlay" id="nav-overlay"></div>
</header>

<style is:global>
/* ===============================
   Accessibility Polish (Focus Rings)
   =============================== */
a:focus-visible, 
button:focus-visible,
.hamburger:focus-visible {
  outline: 3px solid #ffffff;
  outline-offset: 4px;
  border-radius: 4px;
}

html.dark a:focus-visible, 
html.dark button:focus-visible {
  outline: 3px solid var(--accent-color);
}

/* ===============================
   Header (Sticky on all screens)
   =============================== */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 70px;
  min-height: 70px;
  max-height: 70px;
  z-index: 1000;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0 clamp(1rem, 5vw, 6rem);
  background: var(--header-bg); 
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  transition: background 0.3s ease, box-shadow 0.3s ease;
  text-align: center;
}

body.menu-active .site-header,
body:has(.nav-links.expanded) .site-header {
  background: var(--header-bg-solid);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.site-header.menu-shadow {
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.638);
}

@media (max-width: 500px) {
  .site-header {
    height: 70px;
    min-height: 70px;
    max-height: 70px;
    padding: 0 1rem;
  }
}

/* ===============================
   Site Title + Logo
   =============================== */
.site-title {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 0.75rem; 
  flex-shrink: 0;
  min-width: auto;
  position: relative; 
  z-index: 2100;
}

.site-title img {
  height: 100%;
  max-height: 100%;
  width: auto;
  max-width: 40px;
  object-fit: contain;
  transition: width 0.25s ease, height 0.25s ease;
}

.site-title a {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0 10px;
  box-sizing: border-box;
  text-decoration: none;
  color: var(--header-text);
  font-weight: bold;
  font-size: 1.2rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color 0.5s ease;
}

@media (max-width: 768px) {
  .site-title a { padding: 0 8px; font-size: 0 !important; }
  .site-title a > :not(img):not(svg),
  .site-title .site-title-text {
    position: absolute !important; width: 1px !important; height: 1px !important;
    margin: -1px !important; padding: 0 !important; border: 0 !important;
    overflow: hidden !important; clip: rect(0 0 0 0) !important;
    clip-path: inset(50%) !important; white-space: nowrap !important;
  }
}

@media (min-width: 769px) { 
  .site-title a { font-size: 1.2rem !important; }
}

/* ===============================
   Hamburger Menu
   =============================== */
.hamburger {
  position: absolute;
  left: calc(1rem + env(safe-area-inset-left));
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 40px;
  height: 30px;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  z-index: 2000;
  touch-action: manipulation;
  transition: transform 0.2s ease;
}

.hamburger .line {
  height: 3px;
  width: 100%;
  background-color: var(--hamburger-color);
  border-radius: 2px;
  transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55), opacity 0.2s ease;
  transform-origin: center;
}

.hamburger:hover { transform: translateY(-50%) scale(1.1); }
.hamburger:active { transform: translateY(-50%) scale(1.05); transition: transform 0.1s ease; }

.hamburger.active .line1, .hamburger.active .line3 { position: absolute; top: 50%; left: 0; width: 100%; }
.hamburger.active .line1 { transform: translateY(-50%) rotate(45deg) scaleX(1.05); }
.hamburger.active .line2 { opacity: 0; transition: opacity 0.2s ease 0.15s; }
.hamburger.active .line3 { transform: translateY(-50%) rotate(-45deg) scaleX(1.05); }
.hamburger.active:hover { transform: translateY(-50%) scale(1.2); }
.hamburger.active:active { transform: translateY(-50%) scale(1.1); transition: transform 0.1s ease; }

/* ===============================
   Navigation Links
   =============================== */
.nav-links {
  display: flex;
  flex-direction: column;
  position: absolute;
  top: calc(70px + env(safe-area-inset-top));
  left: 0;
  width: 100%;
  max-height: 0;
  overflow: hidden;
  background: var(--header-bg-solid); 
  text-align: left;
  z-index: 1200;
  gap: 0.75rem;
  padding: 0.75rem 1.25rem;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-12px);
  will-change: opacity, transform, max-height, padding-top, visibility;
  transition: opacity 320ms cubic-bezier(0.22, 1, 0.36, 1), transform 380ms cubic-bezier(0.22, 1, 0.36, 1), max-height 480ms ease, padding-top 480ms ease, visibility 0s linear 380ms;
}

.nav-links.expanded {
  max-height: 80vh;
  padding-top: 1rem;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0);
  transition: opacity 320ms cubic-bezier(0.22, 1, 0.36, 1), transform 380ms cubic-bezier(0.22, 1, 0.36, 1), max-height 480ms ease, padding-top 480ms ease, visibility 0s linear 0s;
}

.nav-links a {
  display: block;
  width: fit-content;
  padding: 0.5rem 0.85rem;
  font-weight: bold;
  text-transform: uppercase;
  color: var(--header-text) !important;
  text-decoration: none;
  opacity: 0;
  --scale: 1;
  transform: translateY(-10px) scale(var(--scale));
  transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.3s ease, color 0.3s ease, border-radius 0.2s ease;
  margin: 0.2rem 0;
}

.nav-links a[aria-current="page"],
.nav-links a.active {
  background: var(--nav-active-bg);
  color: var(--header-text) !important;
  border-radius: 8px;
}

.nav-links.expanded a, .nav-links.expanded .dropdown-group { animation: fadeInUp 0.3s forwards; }
.nav-links.expanded > *:nth-child(1) { animation-delay: 0.05s; }
.nav-links.expanded > *:nth-child(2) { animation-delay: 0.10s; }
.nav-links.expanded > *:nth-child(3) { animation-delay: 0.15s; }
.nav-links.expanded > *:nth-child(4) { animation-delay: 0.20s; }
.nav-links.expanded > *:nth-child(5) { animation-delay: 0.25s; }
.nav-links.expanded > *:nth-child(6) { animation-delay: 0.30s; }
.nav-links.expanded > *:last-child { margin-bottom: 1rem; }

@keyframes fadeInUp {
  to { opacity: 1; transform: translateY(0) scale(var(--scale)); }
}

.nav-links a:hover,
.nav-links a:focus {
  background-color: var(--nav-hover-bg);
  border-radius: 8px;
  color: var(--header-text) !important;
  --scale: 1.05;
}

/* ===============================
   Split-Button Dropdown Styles
   =============================== */
.dropdown-group {
  display: flex;
  flex-direction: column;
  position: relative;
  opacity: 0;
  transform: translateY(-10px);
}

.dropdown-primary {
  position: relative; /* Acts as anchor for the absolute toggle */
  display: flex;
  align-items: center;
  width: fit-content;
}

.dropdown-primary a {
  margin: 0 !important; /* Keep the text perfectly flush with other links */
}

/* Mobile: Chevron floating to the left of the text */
.dropdown-toggle {
  position: absolute;
  right: calc(95% + 1px); /* Sits in the empty space just to the left of the text */
  top: 50%;
  transform: translateY(-50%);
  background: transparent !important;
  border: none;
  color: var(--header-text);
  cursor: pointer;
  padding: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55); /* Bouncy feel */
  z-index: 10;
}

.dropdown-toggle:hover, .dropdown-toggle:focus {
  transform: translateY(-50%) scale(1.25); /* Bounces up on hover */
}
.dropdown-toggle:active {
  transform: translateY(-50%) scale(0.9); /* Sinks when clicked */
}

.dropdown-toggle .chevron {
  transition: transform 0.3s ease;
}

.dropdown-group.open .dropdown-toggle .chevron {
  transform: rotate(180deg);
}

/* Dropdown Content */
.dropdown-menu {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.4s ease, opacity 0.3s ease, padding 0.3s ease;
  padding-left: 0.85rem; 
}

.dropdown-group.open .dropdown-menu {
  max-height: 200px;
  opacity: 1;
  padding-top: 0.25rem;
  padding-bottom: 0.5rem;
}

.dropdown-menu a {
  font-size: 0.85rem !important; 
  padding: 0.4rem 0.85rem !important;
  margin: 0 !important;
  transform: translateY(0) scale(1) !important; 
  opacity: 1 !important;
}

/* ===============================
   Navigation Overlay
   =============================== */
.nav-overlay {
  position: fixed;
  top: 70px;
  left: 0;
  width: 100%;
  height: calc(100vh - 70px);
  background: var(--overlay-bg);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease, background 0.3s ease;
  z-index: 1100;
  -webkit-overflow-scrolling: touch;
}

.nav-overlay.active { opacity: 1; visibility: visible; }

/* ===============================
   Responsive Adjustments
   =============================== */
@media (max-width: 1000px) {
  .nav-links a { font-size: 0.95rem; margin: 0 0.8rem; }
}

@media (max-width: 1599px) {
  .site-header { position: fixed; top: 0; left: 0; right: 0; justify-content: center; padding: 0 1rem; z-index: 2100; }
  .hamburger { position: absolute; left: calc(1rem + env(safe-area-inset-left)); z-index: 2200; }
  .site-title a { display: inline-flex; align-items: center; justify-content: center; max-width: 100%; overflow: hidden; text-overflow: ellipsis; gap: 0.5rem; }
}

@media (max-width: 600px) {
  .nav-links a { font-size: 0.9rem; margin: 0 0.6rem; }
}

@media (max-width: 500px) {
  .site-header { height: 70px; min-height: 70px; max-height: 70px; padding: 0 1rem; }
  .nav-links { top: calc(70px + env(safe-area-inset-top)); padding: 1rem 0; }
  .site-title img { max-width: 40px; height: auto; }
}

/* ===============================
   Desktop Layout (Min-Width 1600px)
   =============================== */
@media (min-width: 1500px) {
  .site-title { position: static; text-align: left; }
  .site-title a { gap: 0.6rem; }
  .site-title .site-title-text { position: static; width: auto; height: auto; margin: 0; padding: 0; overflow: visible; clip: auto; clip-path: none; white-space: nowrap; display: inline-block; }
}

@media (min-width: 1600px) {
  .hamburger { display: none; }
  .site-header { height: 70px; justify-content: flex-start; }
  .site-title { position: relative; z-index: 2100; max-width: calc(50vw - 480px); min-width: 0; }

  .nav-links {
    position: absolute; left: 50%; top: 0; transform: translateX(-50%); display: flex !important; flex-direction: row; justify-content: center; 
    align-items: center !important; /* Forces perfect vertical centering for all links */
    flex-wrap: nowrap; width: max-content; max-height: none; background: transparent !important; gap: 4px; padding-left: 0; padding-right: 0; overflow: visible; height: 100%; z-index: 1000 !important; opacity: 1 !important; visibility: visible !important; pointer-events: auto !important; transition: none; 
  }

  .nav-links a { 
    display: inline-flex; align-items: center; justify-content: center; 
    height: auto !important; 
    padding: 0.5rem 1.2rem !important; 
    margin: 0 !important;
    white-space: nowrap; opacity: 1 !important; 
    transform: translateY(0) scale(var(--scale)) !important; 
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.25s ease, border-radius 0.2s ease; 
  }
  
  /* Desktop Dropdown Behavior */
  .dropdown-group {
    flex-direction: row;
    align-items: center;
    height: auto !important;
    opacity: 1;
    transform: translateY(0) !important; 
    margin: 0 !important;
  }
  
  .dropdown-primary { 
    height: auto !important; 
    z-index: 2600; /* Forces button to sit ON TOP of the dropdown menu */
  }
  
  /* HIDE the chevron toggle on desktop */
  .dropdown-toggle { display: none !important; }

  /* Desktop Hover Menu Alignment */
  .dropdown-menu {
    position: absolute;
    top: 140% !important; /* Snaps flush to the bottom of the button */
    left: 50%;
    transform: translateX(-50%);
    background: var(--header-bg); 
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 0 0 12px 12px !important; 
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    padding: 0 !important;
    min-width: 160px;
    align-items: stretch;
    z-index: 2500; /* Sits BEHIND the primary button */
    margin-top: -2px; /* Pulls menu up slightly to hide the seam when the primary button scales up */
  }
  
  /* Open the menu on HOVER */
  .dropdown-group:hover .dropdown-menu,
  .dropdown-group:focus-within .dropdown-menu {
    max-height: 200px;
    opacity: 1;
    padding: 0.5rem !important;
  }

  /* Dropdown Group Hover Reactivity */
  .dropdown-group:hover .dropdown-primary a,
  .dropdown-group.open .dropdown-primary a {
    background-color: var(--nav-hover-bg);
    color: var(--header-text) !important;
    --scale: 1.05; 
    border-bottom-left-radius: 0 !important; /* Flattens bottom corners to merge seamlessly with the menu below */
    border-bottom-right-radius: 0 !important;
  }

  .dropdown-menu a { width: 100% !important; justify-content: flex-start !important; padding: 0.8rem 1.2rem !important; border-radius: 6px !important; }
}

@media (prefers-reduced-motion: reduce) {
  .hamburger, .hamburger .line, .nav-links, .nav-links a, .nav-overlay, .dropdown-menu, .dropdown-toggle .chevron { transition: none !important; animation: none !important; }
}
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const hamburger = document.getElementById("hamburger");
    const nav = document.getElementById("nav");
    const navOverlay = document.getElementById("nav-overlay");
    const navLinks = nav?.querySelectorAll("a");
    
    const dropdownToggle = document.querySelector('.dropdown-toggle');
    const dropdownGroup = document.querySelector('.dropdown-group');

    // --- SMART ACTIVE LINK HIGHLIGHTING ---
    if (navLinks) {
      const currentPath = window.location.pathname;
      
      navLinks.forEach(link => {
        link.classList.remove("active");
        link.removeAttribute("aria-current");
      });

      let bestMatchPath = "";
      let longestMatchLength = 0;

      navLinks.forEach((link) => {
        const linkPath = new URL(link.href).pathname;
        const isMatch = linkPath === "/" ? currentPath === "/" : currentPath.startsWith(linkPath);
        
        if (isMatch && linkPath.length > longestMatchLength) {
          bestMatchPath = linkPath;
          longestMatchLength = linkPath.length;
        }
      });

      if (bestMatchPath) {
        navLinks.forEach(link => {
           if (new URL(link.href).pathname === bestMatchPath) {
              link.classList.add("active");
              link.setAttribute("aria-current", "page");
           }
        });
      }
    }

    // --- MOBILE DROPDOWN CLICK LOGIC ---
    if (dropdownToggle && dropdownGroup && !dropdownToggle.hasAttribute('data-initialized')) {
      dropdownToggle.setAttribute('data-initialized', 'true');

      dropdownToggle.addEventListener('click', (e) => {
        e.preventDefault(); 
        dropdownGroup.classList.toggle('open');
        dropdownToggle.setAttribute('aria-expanded', dropdownGroup.classList.contains('open').toString());
      });
    }

    // --- HAMBURGER MENU LOGIC ---
    if (hamburger && nav && navOverlay && !hamburger.hasAttribute("data-initialized")) {
      hamburger.setAttribute("data-initialized", "true"); 

      hamburger.addEventListener("click", () => {
        nav.classList.toggle("expanded");
        hamburger.classList.toggle("active");
        navOverlay.classList.toggle("active");
        document.body.classList.toggle("menu-active");
        
        if (!nav.classList.contains("expanded") && dropdownGroup) {
            dropdownGroup.classList.remove('open');
            if(dropdownToggle) dropdownToggle.setAttribute('aria-expanded', 'false');
        }

        hamburger.setAttribute("aria-expanded", nav.classList.contains("expanded").toString());
      });

      navOverlay.addEventListener("click", () => {
        nav.classList.remove("expanded");
        hamburger.classList.remove("active");
        navOverlay.classList.remove("active");
        document.body.classList.remove("menu-active");
        hamburger.setAttribute("aria-expanded", "false");
      });

      navLinks?.forEach((link) => {
        link.addEventListener("click", () => {
          if (nav.classList.contains("expanded")) {
            nav.classList.remove("expanded");
            hamburger.classList.remove("active");
            navOverlay.classList.remove("active");
            document.body.classList.remove("menu-active");
            hamburger.setAttribute("aria-expanded", "false");
          }
        });
      });
    }
  });
</script>