---
const { parent = '/blog', label = 'Back' } = Astro.props;
---

<div class="back-btn-wrapper">
  <a
    class="back-btn"
    href={parent}
    role="button"
    aria-label={label}
    data-parent={parent}
  >
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>{label}</span>
  </a>
</div>

<style>
  /* ===============================
     Wrapper for Perfect Alignment
     =============================== */
  .back-btn-wrapper {
    width: 100%;
    max-width: 100ch; /* Matches your global .layout-content width! */
    margin: 0 auto 1.5rem auto; /* Centers the wrapper, adds space below */
    padding: 0 1rem; /* Matches your global layout padding */
    display: flex;
    justify-content: flex-start; /* Forces the button to snap to the left edge */
  }

  /* ===============================
     Modern Pill Appearance
     =============================== */
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem 0.5rem 0.75rem; /* Slightly less padding on the left to balance the icon */
    border-radius: 999px; /* Perfect pill shape */
    background-color: var(--social-bg); /* Inherits your subtle grey from global.css */
    color: var(--text-color) !important;
    font-weight: bold;
    font-size: 0.95rem;
    text-decoration: none !important; /* Kills global link underlines */
    
    /* Smooth, bouncy physics */
    /* Decoupled physics: Fast bouncy lift, but a slow, smooth color fade */
    transition: background-color 0.5s ease-in-out, 
                color 0.5s ease-in-out, 
                transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.5s ease-in-out;
  }

  html.dark .back-btn {
    background-color: var(--toggle-track-bg); /* Dark mode subtle background */
  }

  /* ===============================
     Hover Animations
     =============================== */
  .back-btn:hover {
    background-color: var(--accent-color);
    color: #ffffff !important;
  }

  html.dark .back-btn:hover {
    background-color: var(--accent-color);
    color: #ffffff !important;
  }

  .back-btn svg {
    transition: transform 0.3s ease;
  }

  .back-btn:hover svg {
    transform: translateX(-3px); /* Nudges the arrow even further left on hover */
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.querySelector('.back-btn[data-parent]');
    if (!btn) return;

    const parent = btn.getAttribute('data-parent');
    const sameOriginReferrer = document.referrer && new URL(document.referrer).origin === location.origin;

    btn.addEventListener('click', function (e) {
      if ((history.length > 1 && sameOriginReferrer)) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>