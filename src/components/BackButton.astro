---
const { parent = '/blog', label = 'Back' } = Astro.props;
---

<div class="back-btn-wrapper">
  <a
    class="back-btn"
    href={parent}
    role="button"
    aria-label={label}
    data-parent={parent}
  >
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span>{label}</span>
  </a>
</div>

<style>
  /* ===============================
     Wrapper for Perfect Alignment
     =============================== */
  .back-btn-wrapper {
    width: 100%;
    margin-bottom: 1.5rem; 
    display: flex;
    justify-content: flex-start;
    /* Removed the max-width and padding so it perfectly aligns inside the blog post container! */
  }

  /* ===============================
     Modern Pill Appearance
     =============================== */
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.2rem 0.5rem 0.8rem;
    border-radius: 999px; /* Perfect pill shape */
    border: 2px solid var(--toggle-track-border);
    background-color: var(--social-bg);
    color: var(--text-color) !important; /* The !important shields it from global styles */
    font-weight: bold;
    font-size: 0.95rem;
    text-decoration: none !important; /* Kills global link underlines */
    
    /* MATCHING SYSTEM: Unified 0.25s timing */
    transition: all 0.25s ease-in-out !important;
  }

  html.dark .back-btn {
    background-color: var(--footer-bg);
    border-color: var(--toggle-track-border);
  }

  /* ===============================
     Hover Animations
     =============================== */
  .back-btn:hover {
    background-color: var(--accent-color);
    border-color: var(--accent-color);
    color: #ffffff !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  }

  html.dark .back-btn:hover {
    background-color: var(--accent-color);
    border-color: var(--accent-color);
    color: #ffffff !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4); /* Deeper shadow for dark mode */
  }

  .back-btn svg {
    transition: transform 0.25s ease-in-out;
  }

  .back-btn:hover svg {
    transform: translateX(-3px); /* Nudges the arrow even further left on hover */
  }
  
  /* Force hide any global external link icons that might try to attach */
  .back-btn::after {
    display: none !important;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn = document.querySelector('.back-btn[data-parent]');
    if (!btn) return;

    const parent = btn.getAttribute('data-parent');
    const sameOriginReferrer = document.referrer && new URL(document.referrer).origin === location.origin;

    btn.addEventListener('click', function (e) {
      if ((history.length > 1 && sameOriginReferrer)) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>