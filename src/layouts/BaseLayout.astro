---
// 1. Import the Font component
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brighton and Co</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    
    <Font cssVariable="--font-raleway" preload />
  </head>
  <body>
    
    <Header />

    <div class="page-wrapper">
      <main class="layout-content">
        <slot />
      </main>

      <Footer />
    </div>

    <script type="module">
      document.addEventListener("DOMContentLoaded", () => {
        const themeToggle = document.getElementById("theme-toggle");
        const themeIcon = themeToggle?.querySelector(".theme-icon");

        // Theme toggle logic (Kept globally since it handles document body classes)
        if (themeToggle && themeIcon) {
          const spinIcon = () => {
            themeIcon.classList.add("spin");
            setTimeout(() => themeIcon.classList.remove("spin"), 500);
          };

          const setTheme = (theme) => {
            spinIcon();
            if (theme === "dark") {
              document.documentElement.classList.add("dark");
              themeIcon.textContent = "🌙";
              localStorage.setItem("theme", "dark");
            } else {
              document.documentElement.classList.remove("dark");
              themeIcon.textContent = "☀️";
              localStorage.setItem("theme", "light");
            }
          };

          // Initialize theme
          setTheme(localStorage.getItem("theme") || "light");

          themeToggle.addEventListener("click", () => {
            const current = document.documentElement.classList.contains("dark") ? "dark" : "light";
            setTheme(current === "dark" ? "light" : "dark");
          });
        }
      });
    </script>
  </body>
</html>