---
import { ClientRouter, fade } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Brighton and Co</title>
    <link rel="icon" type="image/png" href="/favicon-light.png" id="dynamic-favicon" />  
    <Font cssVariable="--font-raleway" preload />
    
    <ClientRouter />
    <script is:inline>
      // NEW: Favicon swapper function
      const syncFavicon = (isDark) => {
        const favicon = document.getElementById("dynamic-favicon");
        if (favicon) {
          favicon.href = isDark ? '/favicon-dark.png' : '/favicon-light.png';
        }
      };

      const applyTheme = () => {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = theme === "dark" || (!theme && prefersDark);
        
        if (isDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
        
        // NEW: Apply the correct favicon instantly on page load
        syncFavicon(isDark);
      };

      // 1. Run immediately on initial page load to prevent flashing
      applyTheme();

      // 2. Run immediately on every page navigation (View Transitions)
      document.addEventListener("astro:after-swap", applyTheme);
      
      // 3. NEW: Listen for your ThemeToggle component's custom event to swap in real-time!
      document.addEventListener('themechange', (e) => {
        syncFavicon(e.detail.theme === 'dark');
      });
    </script>
  </head>
  <body>
    
    <Header />

    <div class="page-wrapper">
      <main class="layout-content" transition:animate={fade({ duration: '0.4s' })}>
        <slot />
      </main>

      <Footer />
    </div>

    <script type="module">
      document.addEventListener("astro:page-load", () => {
        const themeToggle = document.getElementById("theme-toggle");
        const themeIcon = themeToggle?.querySelector(".theme-icon");

        if (themeToggle && themeIcon) {
          const spinIcon = () => {
            themeIcon.classList.add("spin");
            setTimeout(() => themeIcon.classList.remove("spin"), 500);
          };

          const setTheme = (theme) => {
            spinIcon();
            if (theme === "dark") {
              document.documentElement.classList.add("dark");
              themeIcon.textContent = "🌙";
              localStorage.setItem("theme", "dark");
            } else {
              document.documentElement.classList.remove("dark");
              themeIcon.textContent = "☀️";
              localStorage.setItem("theme", "light");
            }
          };

          setTheme(localStorage.getItem("theme") || "light");

          const newToggle = themeToggle.cloneNode(true);
          themeToggle.parentNode.replaceChild(newToggle, themeToggle);

          newToggle.addEventListener("click", () => {
            const current = document.documentElement.classList.contains("dark") ? "dark" : "light";
            setTheme(current === "dark" ? "light" : "dark");
          });
        }
      });
    </script>
  </body>
</html>