---
import { ClientRouter, fade } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from "../components/Footer.astro";
import "../styles/global.css";

// 1. IMPORT THE COMPONENT HERE
import { SimpleAnalytics } from 'astro-simpleanalytics-plugin';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TEST: Brighton and Co</title>
    
    <!-- BULLETPROOF CSP -->
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self'; 
      script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://static.cloudflareinsights.com https://api.websitecarbon.com https://scripts.simpleanalyticscdn.com; 
      style-src 'self' 'unsafe-inline'; 
      connect-src 'self' https://cloudflareinsights.com https://api.websitecarbon.com https://queue.simpleanalyticscdn.com https://unpkg.com; 
      font-src 'self' data: https://fonts.gstatic.com; 
      img-src 'self' data: blob: https: https://queue.simpleanalyticscdn.com https://simpleanalyticsbadges.com;
    ">
    
    <link rel="icon" href="/favicon.png" type="image/png" />
    
    <Font cssVariable="--font-raleway" preload />
    
    <ClientRouter />
    <script is:inline>
      const applyTheme = () => {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      // Run on initial load and every view transition
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>
  <body>
    
    <Header />

    <div class="page-wrapper">
      <main class="layout-content" transition:animate={fade({ duration: '0.4s' })}>        
        <slot />
      </main>

      <Footer />
    </div>

    <script type="module">
      // 2. Changed DOMContentLoaded to astro:page-load so scripts survive transitions!
      document.addEventListener("astro:page-load", () => {
        const themeToggle = document.getElementById("theme-toggle");
        const themeIcon = themeToggle?.querySelector(".theme-icon");

        // Theme toggle logic
        if (themeToggle && themeIcon) {
          const spinIcon = () => {
            themeIcon.classList.add("spin");
            setTimeout(() => themeIcon.classList.remove("spin"), 500);
          };

          const setTheme = (theme) => {
            spinIcon();
            if (theme === "dark") {
              document.documentElement.classList.add("dark");
              themeIcon.textContent = "🌙";
              localStorage.setItem("theme", "dark");
            } else {
              document.documentElement.classList.remove("dark");
              themeIcon.textContent = "☀️";
              localStorage.setItem("theme", "light");
            }
          };

          // Initialize theme
          setTheme(localStorage.getItem("theme") || "light");

          // Remove old event listeners first to prevent duplicates
          const newToggle = themeToggle.cloneNode(true);
          themeToggle.parentNode.replaceChild(newToggle, themeToggle);

          newToggle.addEventListener("click", () => {
            const current = document.documentElement.classList.contains("dark") ? "dark" : "light";
            setTheme(current === "dark" ? "light" : "dark");
          });
        }
      });
    </script>
    
    <!-- 2. PLACE THE COMPONENT HERE! -->
    <SimpleAnalytics
    collectDNT={true}
     />
  </body>
</html>