---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/about-me.css";
import BackButton from "../../components/BackButton.astro";
import "../../styles/blog.css";
import PhotoCarousel from '../../components/PhotoCarousel.jsx';

// 1. Import your JSON database
import rawVintedData from '../../data/vinted.json';

// 2. Define the TypeScript blueprint so VS Code knows exactly what to expect
interface VintedItem {
  title: string;
  url: string;
  imageUrl: string;
}

interface VintedData {
  popularItems: VintedItem[];
  moreItems: VintedItem[];
}

// 3. Tell TypeScript that our imported JSON matches this blueprint
const vintedData = rawVintedData as VintedData;

const pageTitle = "My Vinted";

// 4. Automatically format the JSON data for your carousels (with strict typing)
const popularCarouselImages = vintedData.popularItems.map((item: VintedItem) => ({
  src: item.imageUrl,
  alt: item.title,
  url: item.url
}));

const moreCarouselImages = vintedData.moreItems.map((item: VintedItem) => ({
  src: item.imageUrl,
  alt: item.title,
  url: item.url
}));
---
<BaseLayout pageTitle={pageTitle}>
  <div class="page-center">
    <h1>My Vinted:</h1>
  </div>
  <BackButton parent="/about-me" label="Back to About Me" />
  
  <section class="about-cards">
    <div class="card about-me">
      <div class="about-content">
        <div class="about-text">
          <h2>My Vinted Account:</h2>
          <p>You can find my Vinted account at <a href="https://www.vinted.co.uk/member/272494517" class="inline-link" target="_blank" rel="noopener noreferrer">@itsharryb1</a>, where I sell old clothes and accessories.</p>
          <p>All the items I sell are in good condition, so that they still have plenty of life left in them, ready for their next home.</p>
          <p>Below are a selection of items currently available to buy. </p>
          <p>(coming soon - if you click or tap on an image, you can view more details about each item).</p>
        </div>
      </div>
    </div>
    
    <div class="card">
      <h2>Popular Items:</h2>
      <ul class="custom-bullets">
        <p>These are a selection of popular items from my Vinted account:</p>
        
        {/* Added strict types to item and index */}
        {vintedData.popularItems.map((item: VintedItem, index: number) => (
          <li>
            Image {index + 1}: {item.title} - <a href={item.url} class="inline-link" target="_blank" rel="noopener noreferrer"> View on Vinted</a>
          </li>
        ))}
      </ul>
      
      <PhotoCarousel client:visible images={popularCarouselImages} />
    </div>
    
    <div class="card">
      <h2>More Items:</h2>
      <ul class="custom-bullets">
        <p>These are a selection of other items from my Vinted account:</p>
        
        {/* Added strict types to item and index */}
        {vintedData.moreItems.map((item: VintedItem, index: number) => (
          <li>
            Image {index + 1}: {item.title} - <a href={item.url} class="inline-link" target="_blank" rel="noopener noreferrer"> View on Vinted</a>
          </li>
        ))}
      </ul>
      
      <PhotoCarousel client:visible images={moreCarouselImages} />
    </div>

  </section>
</BaseLayout>