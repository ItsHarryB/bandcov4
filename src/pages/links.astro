---
import BaseLayout from '../layouts/BaseLayout.astro';
import Social from '../components/Social.astro';

const pageTitle = "Links";

const socials = [
  { platform: "Twitter", username: "ItsHarryB" },
  { platform: "LinkedIn", url: "https://www.linkedin.com/in/harry-brighton-8a2b971a4/" },
  { platform: "Instagram", username: "ItsHarryB_" },
];

const otherLinks = [
  { platform: "GitHub", username: "ItsHarryB" },
  { platform: "Vinted", url: "https://www.vinted.co.uk/member/272494517" },
  { platform: "eBay", username: "itsharryb" }
];
---
<BaseLayout>
  <div class="page-center">
    <h1>{pageTitle}</h1>
  </div>

  <!-- Social Media Links -->
  <h2>Social Media -</h2>
  <div class="social-cards-grid">
    {socials.map((s) => (
      <Social platform={s.platform} username={s.username} url={s.url} />
    ))}
  </div>

  <!-- Other Links -->
  <h2>Other Links -</h2>
  <div class="social-cards-grid other-links">
    {otherLinks.map((l) => (
      <Social platform={l.platform} username={l.username} url={l.url} />
    ))}
  </div>
</BaseLayout>

<style is:global>
/* ==========================================================
     Card Base State (Mouse Leave)
     ========================================================== */
  .social-cards-grid a {
    /* MATCHING BLOG.CSS: 0.25s ease-in-out drop */
    transition: transform 0.25s ease-in-out,
                box-shadow 0.25s ease-in-out,
                background-color 0.25s ease-in-out,
                color 0.25s ease-in-out !important;
  }

  /* ==========================================================
     Card Hover State (Mouse Enter)
     ========================================================== */
  .social-cards-grid a:hover {
    /* MATCHING BLOG.CSS: -6px lift and shadow */
    transform: translateY(-6px) !important;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2) !important;
    
    /* MATCHING BLOG.CSS: 0.3s bouncy lift */
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), 
                box-shadow 0.3s ease,
                background-color 0.3s ease,
                color 0.3s ease !important;
  }

  /* Deepen the shadow slightly in dark mode */
  html.dark .social-cards-grid a:hover {
    box-shadow: 0 10px 25px rgba(0,0,0,0.5) !important;
  }
</style>