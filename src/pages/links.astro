---
import BaseLayout from '../layouts/BaseLayout.astro';
import Social from '../components/Social.astro';

const pageTitle = "Links";

const socials = [
  { platform: "Twitter", username: "ItsHarryB" },
  { platform: "LinkedIn", url: "https://www.linkedin.com/in/harry-brighton-8a2b971a4/" },
  { platform: "Instagram", username: "ItsHarryB_" },
];

const otherLinks = [
  { platform: "GitHub", username: "ItsHarryB" },
  { platform: "Vinted", url: "https://www.vinted.co.uk/member/272494517" },
  { platform: "eBay", username: "itsharryb" }
];
---
<BaseLayout>
  <div class="page-center">
    <h1>{pageTitle}</h1>
  </div>

  <!-- Social Media Links -->
  <h2>Social Media -</h2>
  <div class="social-cards-grid">
    {socials.map((s) => (
      <Social platform={s.platform} username={s.username} url={s.url} />
    ))}
  </div>

  <!-- Other Links -->
  <h2>Other Links -</h2>
  <div class="social-cards-grid other-links">
    {otherLinks.map((l) => (
      <Social platform={l.platform} username={l.username} url={l.url} />
    ))}
  </div>
</BaseLayout>

<style>
  /* ==========================================================
     Card Base State (The Smooth, "Parachute" Drop on Un-Hover)
     ========================================================== */
  .social-cards-grid a {
    /* We use !important to guarantee it overrides any default transitions built into the Social.astro component */
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.5s,
                color 0.5s !important;
  }

  /* ==========================================================
     Card Hover State (The Fast, Bouncy Lift)
     ========================================================== */
  .social-cards-grid a:hover {
    transform: translateY(-8px) !important;
    box-shadow: 0 15px 30px rgba(0,0,0,0.2) !important;
    
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), 
                box-shadow 0.2s ease !important;
  }

  /* Deepen the shadow slightly in dark mode so the pop is still visible against dark backgrounds */
  html.dark .social-cards-grid a:hover {
    box-shadow: 0 15px 30px rgba(0,0,0,0.5) !important;
  }
</style>