---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/bento.css'; /* Your new import! */
const pageTitle = "Home";
import {Image} from 'astro:assets';
import nhmSkeleton from '../assets/images/nhmskeleton.jpg';
import memojiPhoto from '../assets/images/wavememoji.PNG';
---

<BaseLayout pageTitle={pageTitle}>
  <div class="page-center">
    
    <div class="bento-grid layout-content">
      
      <div class="bento-card bento-intro">
        <h2>Welcome to </h2>
        <h2><span class="text-accent">Brighton and Co</span></h2>
        <p>
          This is the main, official website for Brighton and Co.
        </p>
        <p>
          Brighton and Co is my personal website where I share photography and other information, showcasing my work and interests.
        </p>
      </div>

      <a href="/photography/" class="bento-card bento-photo" aria-label="View Photography">
        <Image 
          src={nhmSkeleton} 
          alt="Latest Photography" 
          width={600}
          format="avif"
          quality={60}
          loading="lazy" 
        />
        <div class="bento-photo-overlay">
          <span>Latest Photography &rarr;</span>
        </div>
      </a>

      <div class="bento-card bento-updates">
        <div class="update-header">
          <span class="pulse-dot"></span>
          <h3>Latest Updates</h3>
        </div>
        <ul class="update-list">
          <li><strong>(Mid) April 2026:</strong> A new homepage is designed and launched! A lot of other design tweaks and improvements are made to the site.</li>
          <li><strong>(Early) April 2026:</strong> Added additional pages and made changes to the navigation of the site. This includes a new Vinted page.</li>
          <li><strong>(Late) March 2026:</strong> The website is update to Astro 6.0, with considerable improvements made to site performance and accessibility.</li>
          <li><strong>(Late) November 2025:</strong> Significant efficiency improvements are made to the site.</li>
          <li><strong>4 November 2025:</strong><b> Brighton and Co Version 4 (v4) is launched.</b></li>        
        </ul>
      </div>

      <a href="/about-me/" class="bento-card bento-photo" aria-label="About Me">
        <Image 
          src={memojiPhoto} 
          alt="About Me Portrait" 
          width={600}
          format="avif"
          quality={60}
          loading="lazy" 
        />
        <div class="bento-photo-overlay">
          <span>About Me &rarr;</span>
        </div>
      </a>

      <a href="/shop/" class="bento-card bento-link bento-accent bento-shop" data-astro-reload>
  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
    <path d="M3 6h18"></path>
    <path d="M16 10a4 4 0 0 1-8 0"></path>
  </svg>
  <span>SHOP: B&Co</span>
</a>

      

      <a href="/blog/" class="bento-card bento-link bento-accent">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        <span>Read Blog</span>
      </a>

    </div>
  </div>
</BaseLayout>